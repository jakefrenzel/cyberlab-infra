        {
          "title": "Pods by namespace",
          "url": "/d/85a562078cdf77779eaa1add43ccec1e"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(kube_pod_container_status_restarts_total[1h]))) or vector(0)",
          "instant": true,
          "range": false
