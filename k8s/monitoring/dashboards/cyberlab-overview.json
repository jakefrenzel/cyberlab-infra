    {
      "type": "stat",
      "id": 12,
      "title": "Policy drops (1h)",
      "description": "Packets dropped by policy in the last hour: the host firewall plus NetworkPolicies. Some are expected (blocked probes); a sudden jump means a rule is blocking something real or something is knocking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 14
      },
      "links": [
        {
          "title": "Cilium",
          "url": "/d/vtuWtdumz"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(cilium_drop_count_total{reason=\"Policy denied\"}[1h]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Drops by reason",
      "description": "Every packet Cilium dropped, by reason. \"Unsupported L3 protocol\" is background noise (e.g. IPv6 on an IPv4-only cluster).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 14
      },
      "links": [
        {
          "title": "Cilium",
          "url": "/d/vtuWtdumz"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(cilium_drop_count_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
