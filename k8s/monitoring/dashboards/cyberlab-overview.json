    {
      "type": "stat",
      "id": 6,
      "title": "Container restarts (1h)",
      "description": "Container restarts across the cluster in the last hour. One or two after a rollout is normal; a steady climb is a crash loop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
